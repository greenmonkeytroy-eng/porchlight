# ==============================================================================
# Porchlight OS — Environment Variables Configuration (.env.example)
# System: Porchlight Digital Twin Engine (Twinscape / Timescape Suite)
# ==============================================================================

# General System Settings
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO

# Firefly III Financial Ledger Configuration
FIREFLY_APP_KEY=Some32CharacterRandomString123!
FIREFLY_URL=http://porchlight-firefly:8080
FIREFLY_API_KEY=your_firefly_personal_access_token_here

# Grocy Pantry ERP Configuration
GROCY_URL=http://porchlight-grocy:80
GROCY_API_KEY=your_grocy_api_key_here

# InfluxDB v2 Time-Series Database Configuration
INFLUX_URL=http://porchlight-influxdb:8086
INFLUX_ORG=porchlight-home
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=your_influxdb_admin_token_here
INFLUX_PASSWORD=PorchlightPass123!

# Grafana Scoreboard Portal Configuration
GRAFANA_PASSWORD=PorchlightPass123!

# Home Assistant Core Integration
HOMEASSISTANT_URL=http://localhost:8123
HOMEASSISTANT_TOKEN=your_ha_long_lived_access_token_here

# Porchlight Digital Twin Engine Options
CONFIDENCE_THRESHOLD=0.70
PFOR_ALERT_THRESHOLD=40.0
