# ==============================================================================
# Porchlight OS — Environment Variables (copy to .env and change every secret)
# URLs below are for running the engine locally (python -m app.... from engine/);
# docker-compose overrides them with container hostnames for the engine container.
# ==============================================================================

# General System Settings
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO

# Firefly III Financial Ledger — APP_KEY must be exactly 32 characters
FIREFLY_APP_KEY=SomeRandomStringOf32CharsExactly
FIREFLY_URL=http://localhost:8080
FIREFLY_API_KEY=your_firefly_personal_access_token_here

# Porchlight Provisions (Grocy backend)
GROCY_URL=http://localhost:9283
GROCY_API_KEY=your_grocy_api_key_here

# InfluxDB v2 — INFLUX_TOKEN is also used as the admin token on first InfluxDB boot
INFLUX_URL=http://localhost:8086
INFLUX_ORG=porchlight-home
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=porchlight-dev-token
INFLUX_PASSWORD=PorchlightPass123!

# Grafana Porchlight Portal
GRAFANA_PASSWORD=PorchlightPass123!

# Home Assistant Core
HOMEASSISTANT_URL=http://localhost:8123
HOMEASSISTANT_TOKEN=your_ha_long_lived_access_token_here

# Porchlight Digital Twin Engine Options
CONFIDENCE_THRESHOLD=0.70
PFOR_ALERT_THRESHOLD=40.0
